rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    // Validation
    function isValidCanto(data) {
      return data.nome is string && data.nome.size() <= 200 &&
             data.letra is string && data.letra.size() <= 50000 &&
             data.ownerId == request.auth.uid;
    }

    function isValidAgendaItem(data) {
      return data.titulo is string && data.titulo.size() <= 200 &&
             data.data is string &&
             data.ownerId == request.auth.uid;
    }

    function isValidUserProfile(data) {
      return data.userId == request.auth.uid &&
             data.email is string;
    }

    function isValidMusico(data) {
      return data.nome is string && data.nome.size() <= 100 &&
             data.ownerId == request.auth.uid;
    }

    // Rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming());
      allow delete: if isOwner(userId);
    }

    match /cantos/{cantoId} {
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidCanto(incoming());
      allow update: if isSignedIn() && existing().ownerId == request.auth.uid && isValidCanto(incoming());
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }

    match /agenda/{agendaId} {
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidAgendaItem(incoming());
      allow update: if isSignedIn() && existing().ownerId == request.auth.uid && isValidAgendaItem(incoming());
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }

    match /musicos/{musicoId} {
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidMusico(incoming());
      allow update: if isSignedIn() && existing().ownerId == request.auth.uid && isValidMusico(incoming());
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }
  }
}
